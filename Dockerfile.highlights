FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-venv ca-certificates \
    && python3 -m venv /opt/downloader \
    && /opt/downloader/bin/pip install --no-cache-dir "yt-dlp[default]" \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/downloader/bin:${PATH}"
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
CMD ["node", "src/highlights/runner.js"]
